{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Snapshot",
  "type": "object",
  "properties": {
    "$schema": {
      "type": [
        "string",
        "null"
      ]
    },
    "format": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "updated_at": {
      "type": "string"
    },
    "content_sha256": {
      "type": "string"
    },
    "providers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Provider"
      }
    },
    "decision_models": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/DecisionModel"
      }
    },
    "image_models": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ImageModel"
      }
    },
    "catalog": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/CatalogProvider"
      }
    }
  },
  "required": [
    "format",
    "updated_at",
    "content_sha256"
  ],
  "$defs": {
    "Provider": {
      "type": "object",
      "properties": {
        "slug": {
          "type": "string"
        },
        "display_name": {
          "type": "string"
        },
        "family": {
          "$ref": "#/$defs/Family"
        },
        "supports_thinking": {
          "type": "boolean",
          "default": false
        },
        "accepts_arbitrary_models": {
          "type": "boolean",
          "default": false
        },
        "fallback_max_output": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "fallback_context_window": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "serves_fast_mode": {
          "type": "boolean",
          "default": false
        },
        "catalog_slug": {
          "type": [
            "string",
            "null"
          ]
        },
        "pricing_schedule": {
          "anyOf": [
            {
              "$ref": "#/$defs/PricingSchedule"
            },
            {
              "type": "null"
            }
          ]
        },
        "models_from": {
          "type": [
            "string",
            "null"
          ]
        },
        "generations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Generation"
          }
        },
        "models": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ModelEntry"
          }
        },
        "price_periods": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PricePeriod"
          }
        },
        "availability": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Availability"
          }
        },
        "requires": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "slug",
        "display_name",
        "family",
        "fallback_context_window"
      ]
    },
    "Family": {
      "description": "Known families are claude, generic, gemini, glm, gpt, synthetic. Other strings require a newer Caudra.",
      "type": "string",
      "examples": [
        "claude",
        "generic",
        "gemini",
        "glm",
        "gpt",
        "synthetic"
      ]
    },
    "PricingSchedule": {
      "type": "object",
      "properties": {
        "windows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PricingWindow"
          }
        },
        "multiplier": {
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "multiplier"
      ]
    },
    "PricingWindow": {
      "type": "object",
      "properties": {
        "start": {
          "type": "integer",
          "format": "uint8",
          "minimum": 0,
          "maximum": 255
        },
        "end": {
          "type": "integer",
          "format": "uint8",
          "minimum": 0,
          "maximum": 255
        }
      },
      "required": [
        "start",
        "end"
      ]
    },
    "Generation": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "members": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "label"
      ]
    },
    "ModelEntry": {
      "type": "object",
      "properties": {
        "prefixes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "small": {
          "type": "boolean",
          "default": false
        },
        "default": {
          "type": "boolean",
          "default": false
        },
        "vision": {
          "type": "boolean",
          "default": false
        },
        "family": {
          "$ref": "#/$defs/Family"
        },
        "pricing": {
          "$ref": "#/$defs/Pricing"
        },
        "max_output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "context_window": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "window_excludes_output": {
          "type": "boolean"
        },
        "reasoning_options": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/ReasoningOption"
          }
        },
        "api": {
          "anyOf": [
            {
              "$ref": "#/$defs/Api"
            },
            {
              "type": "null"
            }
          ]
        },
        "plan_context_window": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "supports_thinking": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "requires": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "family",
        "pricing",
        "context_window"
      ]
    },
    "Pricing": {
      "type": "object",
      "properties": {
        "input": {
          "type": "number",
          "format": "double"
        },
        "output": {
          "type": "number",
          "format": "double"
        },
        "cache_write": {
          "type": "number",
          "format": "double"
        },
        "cache_read": {
          "type": "number",
          "format": "double"
        },
        "fast": {
          "anyOf": [
            {
              "$ref": "#/$defs/FastPricing"
            },
            {
              "type": "null"
            }
          ]
        },
        "tiers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Tier"
          }
        }
      },
      "required": [
        "input",
        "output",
        "cache_write",
        "cache_read"
      ]
    },
    "FastPricing": {
      "type": "object",
      "properties": {
        "input": {
          "type": "number",
          "format": "double"
        },
        "output": {
          "type": "number",
          "format": "double"
        },
        "cache_write": {
          "type": "number",
          "format": "double"
        },
        "cache_read": {
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "input",
        "output",
        "cache_write",
        "cache_read"
      ]
    },
    "Tier": {
      "type": "object",
      "properties": {
        "above": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "input": {
          "type": "number",
          "format": "double"
        },
        "output": {
          "type": "number",
          "format": "double"
        },
        "cache_write": {
          "type": "number",
          "format": "double"
        },
        "cache_read": {
          "type": "number",
          "format": "double"
        },
        "fast": {
          "anyOf": [
            {
              "$ref": "#/$defs/FastPricing"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "above",
        "input",
        "output",
        "cache_write",
        "cache_read"
      ]
    },
    "ReasoningOption": {
      "type": "object",
      "required": [
        "type"
      ],
      "oneOf": [
        {
          "properties": {
            "type": {
              "const": "toggle"
            }
          }
        },
        {
          "properties": {
            "type": {
              "const": "effort"
            },
            "values": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        {
          "properties": {
            "type": {
              "const": "budget_tokens"
            },
            "min": {
              "type": [
                "integer",
                "null"
              ]
            },
            "max": {
              "type": [
                "integer",
                "null"
              ]
            }
          }
        },
        {
          "properties": {
            "type": {
              "type": "string",
              "not": {
                "enum": [
                  "toggle",
                  "effort",
                  "budget_tokens"
                ]
              }
            }
          }
        }
      ]
    },
    "Api": {
      "description": "Known APIs are chat_completions and responses. Other strings require a newer Caudra.",
      "type": "string",
      "examples": [
        "chat_completions",
        "responses"
      ]
    },
    "PricePeriod": {
      "type": "object",
      "properties": {
        "prefix": {
          "type": "string"
        },
        "during": {
          "$ref": "#/$defs/Period"
        },
        "pricing": {
          "$ref": "#/$defs/Pricing"
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "prefix",
        "during",
        "pricing"
      ]
    },
    "Period": {
      "type": "object",
      "properties": {
        "from": {
          "type": [
            "string",
            "null"
          ]
        },
        "until": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "Availability": {
      "type": "object",
      "properties": {
        "prefix": {
          "type": "string"
        },
        "during": {
          "$ref": "#/$defs/Period"
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "prefix",
        "during"
      ]
    },
    "DecisionModel": {
      "type": "object",
      "properties": {
        "protocol": {
          "type": "string"
        },
        "prefixes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "pricing": {
          "$ref": "#/$defs/Pricing"
        },
        "source": {
          "type": "string"
        }
      },
      "required": [
        "protocol",
        "pricing",
        "source"
      ]
    },
    "ImageModel": {
      "description": "A model behind `image_generate`. Image models are their own class: they\nnever appear among the chat models of `/model`.",
      "type": "object",
      "properties": {
        "backend": {
          "description": "The image backend that serves it, such as `openai`, `bfl` or `fal`.",
          "type": "string"
        },
        "id": {
          "description": "The id sent to the backend. An answered id that starts with it, such\nas a dated snapshot, is priced by this entry.",
          "type": "string"
        },
        "display_name": {
          "type": "string"
        },
        "default": {
          "description": "The model a backend uses when none is chosen. At most one per backend.",
          "type": "boolean"
        },
        "pricing": {
          "$ref": "#/$defs/ImagePricing"
        },
        "max_references": {
          "description": "How many reference images one call may carry. 0 means text only.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "default": 0
        },
        "qualities": {
          "description": "The `quality` values the backend accepts, cheapest first. Empty when\nit has no quality setting.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "seed": {
          "type": "boolean"
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "description": "The provider page that states the prices.",
          "type": "string"
        }
      },
      "required": [
        "backend",
        "id",
        "display_name",
        "pricing",
        "source"
      ]
    },
    "ImagePricing": {
      "description": "What one generated image costs, in US dollars. Token rates are per million\ntokens. A cost the backend reports itself always wins over this estimate.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "per_image"
            },
            "image": {
              "type": "number",
              "format": "double"
            },
            "by_quality": {
              "type": "object",
              "additionalProperties": {
                "type": "number",
                "format": "double"
              }
            },
            "input_image": {
              "type": "number",
              "format": "double",
              "default": 0.0
            }
          },
          "required": [
            "type",
            "image"
          ]
        },
        {
          "description": "The first megapixel at `first`, each further one at `extra`, and every\nreference megapixel at `input`.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "per_megapixel"
            },
            "first": {
              "type": "number",
              "format": "double"
            },
            "extra": {
              "type": "number",
              "format": "double"
            },
            "input": {
              "type": "number",
              "format": "double",
              "default": 0.0
            }
          },
          "required": [
            "type",
            "first",
            "extra"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "tokens"
            },
            "text_input": {
              "type": "number",
              "format": "double"
            },
            "image_input": {
              "type": "number",
              "format": "double"
            },
            "image_output": {
              "type": "number",
              "format": "double"
            }
          },
          "required": [
            "type",
            "text_input",
            "image_input",
            "image_output"
          ]
        },
        {
          "description": "Billed against a subscription plan, with no list price per image.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "subscription"
            }
          },
          "required": [
            "type"
          ]
        }
      ]
    },
    "CatalogProvider": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "env": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "npm": {
          "type": "string"
        },
        "api": {
          "type": [
            "string",
            "null"
          ]
        },
        "models": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/CatalogModel"
          }
        }
      },
      "required": [
        "name",
        "npm"
      ]
    },
    "CatalogModel": {
      "type": "object",
      "properties": {
        "limit": {
          "anyOf": [
            {
              "$ref": "#/$defs/CatalogLimits"
            },
            {
              "type": "null"
            }
          ]
        },
        "cost": {
          "anyOf": [
            {
              "$ref": "#/$defs/CatalogCost"
            },
            {
              "type": "null"
            }
          ]
        },
        "provider": {
          "anyOf": [
            {
              "$ref": "#/$defs/CatalogShape"
            },
            {
              "type": "null"
            }
          ]
        },
        "attachment": {
          "type": "boolean",
          "default": false
        },
        "reasoning": {
          "type": "boolean",
          "default": false
        },
        "modalities": {
          "anyOf": [
            {
              "$ref": "#/$defs/CatalogModalities"
            },
            {
              "type": "null"
            }
          ]
        },
        "reasoning_options": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/ReasoningOption"
          }
        },
        "release_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "last_updated": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": [
            "string",
            "null"
          ]
        },
        "tool_call": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "CatalogLimits": {
      "type": "object",
      "properties": {
        "context": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "input": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "output": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        }
      }
    },
    "CatalogCost": {
      "type": "object",
      "properties": {
        "input": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "output": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "cache_read": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "cache_write": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "tiers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CatalogCostTier"
          }
        }
      }
    },
    "CatalogCostTier": {
      "type": "object",
      "properties": {
        "input": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "output": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "cache_read": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "cache_write": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "tier": {
          "$ref": "#/$defs/CatalogTierBoundary"
        }
      },
      "required": [
        "tier"
      ]
    },
    "CatalogTierBoundary": {
      "type": "object",
      "properties": {
        "size": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "size"
      ]
    },
    "CatalogShape": {
      "type": "object",
      "properties": {
        "shape": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "CatalogModalities": {
      "type": "object",
      "properties": {
        "input": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "output": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
